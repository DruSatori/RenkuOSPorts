From 05c85d744c0a3023e7a436633b2a19f7d39baafe Mon Sep 17 00:00:00 2001
From: Augustin Cavalier <waddlesplash@gmail.com>
Date: Fri, 2 Jan 2026 09:42:13 -0600
Subject: [PATCH 1/5] renderdoc: Add Haiku platform support

---
 include/renderdoc_app.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/include/renderdoc_app.h b/include/renderdoc_app.h
index b2d10c5..debd0c7 100644
--- a/include/renderdoc_app.h
+++ b/include/renderdoc_app.h
@@ -35,7 +35,7 @@
 
 #if defined(WIN32) || defined(__WIN32__) || defined(_WIN32) || defined(_MSC_VER)
 #define RENDERDOC_CC __cdecl
-#elif defined(__linux__)
+#elif defined(__linux__) || defined(__HAIKU__)
 #define RENDERDOC_CC
 #elif defined(__APPLE__)
 #define RENDERDOC_CC
-- 
2.47.3


From a1ebf8bbe9f4882ddffa7202af855d4d922ff1d3 Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Sat, 21 Nov 2026 19:01:02 +1000
Subject: [PATCH 2/5] egl/haiku: Do not call a pbuffer's missing window hook.

A pbuffer's framebuffer is created with no BitmapHook (winsysContext
NULL), but eglMakeCurrent on it calls update_size(), which asks that
hook for the window's size: a NULL call. Every program that made a
pbuffer current crashed there (Segment violation in update_size, from
haiku_make_current). An eglSwapBuffers on one would have ended the same
way in hgl_winsys_displaytarget_display, which hands the frame to the
hook.

update_size() now leaves a framebuffer without a hook alone (a pbuffer
keeps the size it was created with), a swap of anything but a window
surface does nothing, as EGL defines it for pbuffers, and the winsys
no longer hands a frame to a missing hook (the front-buffer flush of a
pbuffer takes that path too).
---
 src/egl/drivers/haiku/egl_haiku.cpp         | 8 ++++++++
 src/gallium/winsys/sw/hgl/hgl_sw_winsys.cpp | 5 ++++-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/egl/drivers/haiku/egl_haiku.cpp b/src/egl/drivers/haiku/egl_haiku.cpp
index f2f75c0..5d4b19b 100644
--- a/src/egl/drivers/haiku/egl_haiku.cpp
+++ b/src/egl/drivers/haiku/egl_haiku.cpp
@@ -190,6 +190,9 @@ static void
 update_size(struct hgl_buffer *buffer)
 {
    uint32_t newWidth, newHeight;
+   // A pbuffer has no window to ask: its size is fixed at creation.
+   if (buffer->winsysContext == NULL)
+      return;
    ((BitmapHook *)buffer->winsysContext)->GetSize(newWidth, newHeight);
    if (buffer->newWidth != newWidth || buffer->newHeight != newHeight) {
       buffer->newWidth = newWidth;
@@ -207,6 +210,11 @@ haiku_swap_buffers(_EGLDisplay *disp, _EGLSurface *surf)
    if (hgl_ctx == NULL)
       return EGL_FALSE;
 
+   // EGL gives a swap of a pbuffer no effect, and a pbuffer has no window
+   // (BitmapHook) to hand a frame to.
+   if (surf->Type != EGL_WINDOW_BIT)
+      return EGL_TRUE;
+
    struct st_context *st = hgl_ctx->ctx->st;
    struct pipe_screen *screen = hgl_dpy->disp->fscreen->screen;
 
diff --git a/src/gallium/winsys/sw/hgl/hgl_sw_winsys.cpp b/src/gallium/winsys/sw/hgl/hgl_sw_winsys.cpp
index 6097b11..db026df 100644
--- a/src/gallium/winsys/sw/hgl/hgl_sw_winsys.cpp
+++ b/src/gallium/winsys/sw/hgl/hgl_sw_winsys.cpp
@@ -214,7 +214,10 @@ hgl_winsys_displaytarget_display(struct sw_winsys* winsys,
    unsigned nboxes,
    struct pipe_box *box)
 {
-	assert(contextPrivate);
+	// A pbuffer's framebuffer has no BitmapHook: nothing to show its front
+	// buffer in.
+	if (contextPrivate == NULL)
+		return;
 
 	struct haiku_displaytarget* haikuDisplayTarget
 		= hgl_sw_displaytarget(displayTarget);
-- 
2.47.3


From c2531f16d8e8032abf8472790db8eef23eea5fa9 Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Sat, 21 Nov 2026 19:02:18 +1000
Subject: [PATCH 3/5] egl/haiku: Honour the context attributes, and offer
 EGL_KHR_create_context_no_error.

haiku_create_context ignored the attribute list: hgl_create_context
always asked the state tracker for OpenGL 1.0 compatibility, so a
request for a 4.5 core context got 4.6 compatibility, and debug,
forward-compatible and no-error contexts were ordinary ones.

The context's API, profile, version and flags, as _eglInitContext
reads them, now go to st_api_create_context. The profile follows the
WGL frontend (stw_create_context_attribs): core only for core 3.2 or
later, compatibility otherwise, because there are no profiles before
3.2 and Mesa has no 3.1 with GL_ARB_compatibility. hgl_create_context
takes the state tracker's attributes instead of a visual. A context
the state tracker cannot make fails with EGL_BAD_MATCH, the
KHR_create_context error for an unsupported version, profile or flags;
before, it failed with no error set.

With no-error contexts passed on (ST_CONTEXT_FLAG_NO_ERROR), the
display offers EGL_KHR_create_context_no_error, as the DRI driver
does. Wine's win32u requires it of an EGL display, along with
EGL_KHR_create_context and EGL_KHR_no_config_context
(init_egl_platform in dlls/win32u/opengl.c), and so had no OpenGL
here.
---
 src/egl/drivers/haiku/egl_haiku.cpp     | 57 +++++++++++++++++++++++--
 src/gallium/frontends/hgl/hgl.c         | 12 +-----
 src/gallium/frontends/hgl/hgl_context.h |  3 +-
 3 files changed, 57 insertions(+), 15 deletions(-)

diff --git a/src/egl/drivers/haiku/egl_haiku.cpp b/src/egl/drivers/haiku/egl_haiku.cpp
index 5d4b19b..c16cb98 100644
--- a/src/egl/drivers/haiku/egl_haiku.cpp
+++ b/src/egl/drivers/haiku/egl_haiku.cpp
@@ -26,6 +26,7 @@
 #include <errno.h>
 #include <stdint.h>
 #include <stdio.h>
+#include <string.h>
 
 #include <algorithm>
 
@@ -380,6 +381,7 @@ haiku_initialize_impl(_EGLDisplay *disp, void *platformDisplay)
       disp->Extensions.KHR_gl_colorspace = EGL_TRUE;
 
    disp->Extensions.KHR_create_context = EGL_TRUE;
+   disp->Extensions.KHR_create_context_no_error = EGL_TRUE;
    disp->Extensions.KHR_reusable_sync = EGL_TRUE;
 
    haiku_add_configs_for_visuals(disp);
@@ -428,6 +430,45 @@ haiku_terminate(_EGLDisplay *disp)
 
 // #pragma mark EGLContext
 
+// The state tracker's attributes for an EGL context: its API, profile,
+// version and flags, as _eglInitContext read them from the attribute list.
+// The profile follows the WGL frontend (stw_create_context_attribs): there
+// are no profiles before OpenGL 3.2, and Mesa has no 3.1 with
+// GL_ARB_compatibility, so a context is the compatibility profile unless
+// core 3.2 or later is asked for. Mesa gives the newest version that
+// satisfies the request.
+static bool
+haiku_context_attribs(const _EGLContext *ctx, struct st_context_attribs *attribs)
+{
+   memset(attribs, 0, sizeof(*attribs));
+   hgl_get_st_visual(&attribs->visual, HGL_DOUBLE | HGL_DEPTH);
+   attribs->major = ctx->ClientMajorVersion;
+   attribs->minor = ctx->ClientMinorVersion;
+
+   switch (ctx->ClientAPI) {
+   case EGL_OPENGL_API:
+      if (ctx->Profile == EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT_KHR &&
+          (attribs->major > 3 || (attribs->major == 3 && attribs->minor >= 2)))
+         attribs->profile = API_OPENGL_CORE;
+      else
+         attribs->profile = API_OPENGL_COMPAT;
+      break;
+   case EGL_OPENGL_ES_API:
+      attribs->profile = attribs->major >= 2 ? API_OPENGLES2 : API_OPENGLES;
+      break;
+   default:
+      return false;
+   }
+
+   if (ctx->Flags & EGL_CONTEXT_OPENGL_DEBUG_BIT_KHR)
+      attribs->flags |= ST_CONTEXT_FLAG_DEBUG;
+   if (ctx->Flags & EGL_CONTEXT_OPENGL_FORWARD_COMPATIBLE_BIT_KHR)
+      attribs->flags |= ST_CONTEXT_FLAG_FORWARD_COMPATIBLE;
+   if (ctx->NoError)
+      attribs->flags |= ST_CONTEXT_FLAG_NO_ERROR;
+   return true;
+}
+
 static _EGLContext *
 haiku_create_context(_EGLDisplay *disp, _EGLConfig *conf,
                      _EGLContext *share_list, const EGLint *attrib_list)
@@ -436,8 +477,7 @@ haiku_create_context(_EGLDisplay *disp, _EGLConfig *conf,
 
    struct haiku_egl_display *hgl_dpy = haiku_egl_display(disp);
 
-   struct st_visual visual;
-   hgl_get_st_visual(&visual, HGL_DOUBLE | HGL_DEPTH);
+   struct st_context_attribs attribs;
 
    struct haiku_egl_context *context =
       (struct haiku_egl_context *)calloc(1, sizeof(*context));
@@ -449,11 +489,20 @@ haiku_create_context(_EGLDisplay *disp, _EGLConfig *conf,
    if (!_eglInitContext(&context->base, disp, conf, share_list, attrib_list))
       goto cleanup;
 
+   if (!haiku_context_attribs(&context->base, &attribs)) {
+      _eglError(EGL_BAD_PARAMETER, "eglCreateContext");
+      goto cleanup;
+   }
+
    context->ctx = hgl_create_context(
-      hgl_dpy->disp, &visual,
+      hgl_dpy->disp, &attribs,
       share_list == NULL ? NULL : haiku_egl_context(share_list)->ctx->st);
-   if (context->ctx == NULL)
+   if (context->ctx == NULL) {
+      // The KHR_create_context error for a version, profile or flags the
+      // implementation does not offer.
+      _eglError(EGL_BAD_MATCH, "eglCreateContext");
       goto cleanup;
+   }
 
    return &context->base;
 
diff --git a/src/gallium/frontends/hgl/hgl.c b/src/gallium/frontends/hgl/hgl.c
index e9af7b6..f5d6a24 100644
--- a/src/gallium/frontends/hgl/hgl.c
+++ b/src/gallium/frontends/hgl/hgl.c
@@ -248,22 +248,14 @@ hgl_destroy_st_framebuffer(struct hgl_buffer *buffer)
 
 
 struct hgl_context*
-hgl_create_context(struct hgl_display *display, struct st_visual* visual, struct st_context* shared)
+hgl_create_context(struct hgl_display *display, const struct st_context_attribs *attribs, struct st_context* shared)
 {
 	struct hgl_context* context = CALLOC_STRUCT(hgl_context);
 	assert(context);
 	context->display = display;
 
-	struct st_context_attribs attribs;
-	memset(&attribs, 0, sizeof(attribs));
-	attribs.options.force_glsl_extensions_warn = false;
-	attribs.profile = API_OPENGL_COMPAT;
-	attribs.visual = *visual;
-	attribs.major = 1;
-	attribs.minor = 0;
-
 	enum st_context_error result;
-	context->st = st_api_create_context(display->fscreen, &attribs, &result, shared);
+	context->st = st_api_create_context(display->fscreen, attribs, &result, shared);
 	if (context->st == NULL) {
 		FREE(context);
 		return NULL;
diff --git a/src/gallium/frontends/hgl/hgl_context.h b/src/gallium/frontends/hgl/hgl_context.h
index 711e63e..f8ae650 100644
--- a/src/gallium/frontends/hgl/hgl_context.h
+++ b/src/gallium/frontends/hgl/hgl_context.h
@@ -78,7 +78,8 @@ struct hgl_context
 struct hgl_buffer* hgl_create_st_framebuffer(struct hgl_display *display, struct st_visual* visual, void *winsysContext);
 void hgl_destroy_st_framebuffer(struct hgl_buffer *buffer);
 
-struct hgl_context* hgl_create_context(struct hgl_display *display, struct st_visual* visual, struct st_context* shared);
+struct st_context_attribs;
+struct hgl_context* hgl_create_context(struct hgl_display *display, const struct st_context_attribs *attribs, struct st_context* shared);
 void hgl_destroy_context(struct hgl_context* context);
 
 // hgl visual
-- 
2.47.3


From 4f09d25c32f4115ffe2afa6848c24f9b73248918 Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Sat, 21 Nov 2026 19:02:45 +1000
Subject: [PATCH 4/5] egl/haiku: Make the config describe the surfaces.

The display's one config said RGBA8888 with a 24-bit depth buffer and
no stencil, but every surface and context was made with
HGL_DOUBLE | HGL_DEPTH: BGRX8888 (no alpha) with a Z24S8 depth-stencil
buffer (hgl_get_st_visual). A program that read the config got the
wrong answer both ways: GL_ALPHA_BITS was 0 on a config with 8 alpha
bits, and GL_STENCIL_BITS 8 on one with none, so a program that asked
for stencil found no config, and an OpenGL layer that builds its pixel
formats from the configs (Wine's win32u does) offered none with
stencil.

Contexts and surfaces now share one visual, HAIKU_VISUAL, with
HGL_ALPHA added, so the colour buffer is BGRA8888 and its 8 alpha bits
are real, and the config says 8 stencil bits. The display target is a
B_RGB32 BBitmap as before (hgl_winsys_convert_cs), so what a BGLView
shows does not change.
---
 src/egl/drivers/haiku/egl_haiku.cpp | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/src/egl/drivers/haiku/egl_haiku.cpp b/src/egl/drivers/haiku/egl_haiku.cpp
index c16cb98..f268f49 100644
--- a/src/egl/drivers/haiku/egl_haiku.cpp
+++ b/src/egl/drivers/haiku/egl_haiku.cpp
@@ -67,6 +67,12 @@ extern "C" {
 
 _EGL_DRIVER_STANDARD_TYPECASTS(haiku_egl)
 
+// The one visual of every context and surface, which the display's one
+// config describes (haiku_add_configs_for_visuals): double-buffered BGRA8888
+// with a Z24S8 depth-stencil buffer (hgl_get_st_visual). Contexts and
+// surfaces must agree on it to be made current together.
+#define HAIKU_VISUAL (HGL_DOUBLE | HGL_DEPTH | HGL_ALPHA)
+
 struct haiku_egl_display {
    int ref_count;
    struct hgl_display *disp;
@@ -109,7 +115,7 @@ haiku_create_window_surface(_EGLDisplay *disp, _EGLConfig *conf,
    }
 
    struct st_visual visual;
-   hgl_get_st_visual(&visual, HGL_DOUBLE | HGL_DEPTH);
+   hgl_get_st_visual(&visual, HAIKU_VISUAL);
 
    wgl_surf->fb =
       hgl_create_st_framebuffer(hgl_dpy->disp, &visual, native_window);
@@ -151,7 +157,7 @@ haiku_create_pbuffer_surface(_EGLDisplay *disp, _EGLConfig *conf,
    }
 
    struct st_visual visual;
-   hgl_get_st_visual(&visual, HGL_DOUBLE | HGL_DEPTH);
+   hgl_get_st_visual(&visual, HAIKU_VISUAL);
 
    wgl_surf->fb = hgl_create_st_framebuffer(hgl_dpy->disp, &visual, NULL);
    if (!wgl_surf->fb) {
@@ -282,7 +288,7 @@ haiku_add_configs_for_visuals(_EGLDisplay *disp)
    conf->base.ConfigID = 1;
    conf->base.BindToTextureRGB = EGL_FALSE;
    conf->base.BindToTextureRGBA = EGL_FALSE;
-   conf->base.StencilSize = 0;
+   conf->base.StencilSize = 8;
    conf->base.TransparentType = EGL_NONE;
    conf->base.NativeRenderable = EGL_TRUE; // Let's say yes
    conf->base.NativeVisualID = 0;          // No visual
@@ -290,7 +296,7 @@ haiku_add_configs_for_visuals(_EGLDisplay *disp)
    conf->base.RenderableType = 0x8;
    conf->base.SampleBuffers = 0; // TODO: How to get the right value ?
    conf->base.Samples = conf->base.SampleBuffers == 0 ? 0 : 0;
-   conf->base.DepthSize = 24; // TODO: How to get the right value ?
+   conf->base.DepthSize = 24;
    conf->base.Level = 0;
    conf->base.MaxPbufferWidth = _EGL_MAX_PBUFFER_WIDTH;
    conf->base.MaxPbufferHeight = _EGL_MAX_PBUFFER_HEIGHT;
@@ -441,7 +447,7 @@ static bool
 haiku_context_attribs(const _EGLContext *ctx, struct st_context_attribs *attribs)
 {
    memset(attribs, 0, sizeof(*attribs));
-   hgl_get_st_visual(&attribs->visual, HGL_DOUBLE | HGL_DEPTH);
+   hgl_get_st_visual(&attribs->visual, HAIKU_VISUAL);
    attribs->major = ctx->ClientMajorVersion;
    attribs->minor = ctx->ClientMinorVersion;
 
-- 
2.47.3


From 19719b8682260885514f65dd607a4d1f60e3d485 Mon Sep 17 00:00:00 2001
From: rations <ehqcar@proton.me>
Date: Sat, 21 Nov 2026 19:02:59 +1000
Subject: [PATCH 5/5] egl/haiku: Print the surface calls only in debug builds.

haiku_create_window_surface, haiku_create_pixmap_surface and
haiku_create_pbuffer_surface each printed their name to stdout, in
release builds too: every BGLView program printed
haiku_create_window_surface, and a program that draws through EGL a
line for every surface it makes. They now use CALLED(), as the rest of
the driver does, which prints (through TRACE) only in builds where
MESA_DEBUG is true.
---
 src/egl/drivers/haiku/egl_haiku.cpp | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/egl/drivers/haiku/egl_haiku.cpp b/src/egl/drivers/haiku/egl_haiku.cpp
index f268f49..6825407 100644
--- a/src/egl/drivers/haiku/egl_haiku.cpp
+++ b/src/egl/drivers/haiku/egl_haiku.cpp
@@ -100,7 +100,7 @@ static _EGLSurface *
 haiku_create_window_surface(_EGLDisplay *disp, _EGLConfig *conf,
                             void *native_window, const EGLint *attrib_list)
 {
-   printf("haiku_create_window_surface\n");
+   CALLED();
    struct haiku_egl_display *hgl_dpy = haiku_egl_display(disp);
 
    struct haiku_egl_surface *wgl_surf =
@@ -134,7 +134,7 @@ static _EGLSurface *
 haiku_create_pixmap_surface(_EGLDisplay *disp, _EGLConfig *conf,
                             void *native_pixmap, const EGLint *attrib_list)
 {
-   printf("haiku_create_pixmap_surface\n");
+   CALLED();
    return NULL;
 }
 
@@ -142,7 +142,7 @@ static _EGLSurface *
 haiku_create_pbuffer_surface(_EGLDisplay *disp, _EGLConfig *conf,
                              const EGLint *attrib_list)
 {
-   printf("haiku_create_pbuffer_surface\n");
+   CALLED();
    struct haiku_egl_display *hgl_dpy = haiku_egl_display(disp);
 
    struct haiku_egl_surface *wgl_surf =
-- 
2.47.3

